<%- include('partials/head', { title: 'Connexion' }) %>
<%- include('partials/nav-public') %>

<section class="section container">
  <div style="max-width:420px;margin:0 auto;">
    <h1 style="font-size:1.7rem;">Connexion</h1>
    <p style="color:var(--ink-soft);margin-bottom:24px;">Accedez au tableau de bord de votre boutique.</p>

    <div class="form-card">
      <% if (erreur) { %><div class="alerte alerte-erreur"><%= erreur %></div><% } %>
      <form method="POST" action="/connexion">
        <div class="champ">
          <label for="email">Adresse email</label>
          <input type="email" id="email" name="email" value="<%= email || '' %>" required>
        </div>
        <div class="champ">
          <label for="mot_de_passe">Mot de passe</label>
          <input type="password" id="mot_de_passe" name="mot_de_passe" required>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Se connecter</button>
      </form>
    </div>

    <p style="text-align:center;margin-top:18px;font-size:0.92rem;">
      Pas encore de boutique ? <a href="/inscription">Creez-en une</a>
    </p>
  </div>
</section>

<%- include('partials/footer') %>
