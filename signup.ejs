<%- include('partials/head', { title: 'Creer ma boutique' }) %>
<%- include('partials/nav-public') %>

<section class="section container">
  <div style="max-width:460px;margin:0 auto;">
    <h1 style="font-size:1.7rem;">Creez votre boutique</h1>
    <p style="color:var(--ink-soft);margin-bottom:24px;">14 jours d'essai gratuit, sans engagement.</p>

    <div class="form-card">
      <% if (erreurs && erreurs.length) { %>
        <div class="alerte alerte-erreur">
          <ul class="liste-erreurs">
            <% erreurs.forEach(function(e) { %><li><%= e %></li><% }) %>
          </ul>
        </div>
      <% } %>

      <form method="POST" action="/inscription">
        <div class="champ">
          <label for="nom_boutique">Nom de la boutique</label>
          <input type="text" id="nom_boutique" name="nom_boutique" value="<%= valeurs.nom_boutique || '' %>" placeholder="Ex: Boutique Aicha" required>
        </div>
        <div class="champ">
          <label for="whatsapp">Numero WhatsApp</label>
          <input type="text" id="whatsapp" name="whatsapp" value="<%= valeurs.whatsapp || '' %>" placeholder="237 6XX XXX XXX" required>
          <div class="aide">Avec l'indicatif pays. C'est ce numero qui recevra les commandes.</div>
        </div>
        <div class="champ">
          <label for="ville">Ville (optionnel)</label>
          <input type="text" id="ville" name="ville" value="<%= valeurs.ville || '' %>" placeholder="Ex: Douala">
        </div>
        <div class="champ">
          <label for="email">Adresse email</label>
          <input type="email" id="email" name="email" value="<%= valeurs.email || '' %>" required>
        </div>
        <div class="champ">
          <label for="mot_de_passe">Mot de passe</label>
          <input type="password" id="mot_de_passe" name="mot_de_passe" minlength="6" required>
        </div>
        <button class="btn btn-primary btn-block" type="submit">Creer ma boutique</button>
      </form>
    </div>

    <p style="text-align:center;margin-top:18px;font-size:0.92rem;">
      Deja un compte ? <a href="/connexion">Connectez-vous</a>
    </p>
  </div>
</section>

<%- include('partials/footer') %>
